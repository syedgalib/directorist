{
  "name": "directorist-business-directory-plugin",
  "version": "8.4.6",
  "description": "A comprehensive solution to create professional looking directory site of any kind. Like Yelp, Foursquare, etc.",
  "main": "index.js",
  "scripts": {
    "start": "wp-scripts start --config webpack.wpscript.js",
    "dev": "webpack --config webpack.dev.js",
    "dev-vue": "webpack --config webpack.dev.vue.js",
    "prod": "node pot.js && webpack --config webpack.prod.js",
    "format": "wp-scripts format ./assets/src",
    "format:resources": "wp-scripts format ./resources/js",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{css,scss,js}": [
      "yarn format",
      "yarn format:resources",
      "git add"
    ],
    "*.php": [
      "composer format"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sovware/directorist"
  },
  "author": "wpWax",
  "license": "GPL-2.0+",
  "homepage": "https://github.com/sovware/directorist",
  "dependencies": {
    "@wordpress/api-fetch": "^7.31.0",
    "@wordpress/components": "^30.2.0",
    "@wordpress/dataviews": "^7.0.0",
    "@wordpress/dom-ready": "^4.31.0",
    "@wordpress/element": "^6.29.0",
    "@wordpress/hooks": "^4.31.0",
    "@wordpress/i18n": "^6.11.0",
    "axios": "^0.21.1",
    "dom-scroll-into-view": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "lodash": "^4.17.20",
    "prettier": "^3.5.3",
    "react-hot-toast": "^2.6.0",
    "react-inlinesvg": "^4.2.0",
    "styled-components": "^6.1.19",
    "vue": "^2.6.11",
    "vue-dndrop": "^1.3.0",
    "vue-multiselect": "^2.1.6",
    "vue-native-color-picker": "^1.1.3",
    "vue-slide-up-down": "^2.0.1",
    "vuedraggable": "^2.24.3",
    "vuex": "^4.1.0",
    "webpack-rtl-plugin": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/runtime": "^7.28.6",
    "@types/react": "^19.2.10",
    "@wordpress/babel-preset-default": "^8.39.0",
    "@wordpress/scripts": "^31.4.0",
    "autoprefixer": "^10.4.24",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.3",
    "file-loader": "^6.2.0",
    "filemanager-webpack-plugin": "^9.0.1",
    "mini-css-extract-plugin": "^2.10.0",
    "postcss-loader": "^8.2.0",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "vue-loader": "^17.4.2",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^3.11.3",
    "webpack-merge": "^5.0.9",
    "webpackbar": "^7.0.0",
    "wp-pot": "^1.9.8"
  },
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "browserslist": [
    "defaults",
    "not ie < 11",
    "last 2 versions",
    "> 1%",
    "iOS 7",
    "last 3 iOS versions"
  ]
}
